<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/cart.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <div class="page">
                <% if (products.length > 0) { %>
                    <% const totalPrice = products.reduce((sum, p) => sum + Number(p.price) * p.quantity, 0); %>
                    <% const totalItems = products.reduce((sum, p) => sum + p.quantity, 0); %>

                    <header class="cart__header">
                        <h1>Your cart</h1>
                        <span class="eyebrow"><%= totalItems %> item<%= totalItems === 1 ? '' : 's' %></span>
                    </header>

                    <ul class="cart__items">
                        <% products.forEach(p => { %>
                            <li class="cart__item">
                                <div class="cart__cover" data-cover data-title="<%= p.title %>">
                                    <img src="<%= p.imageUrl %>" alt="" loading="lazy" decoding="async">
                                </div>

                                <div class="cart__info">
                                    <a class="cart__title" href="/products/<%= p._id %>"><%= p.title %></a>
                                    <% if (p.author) { %>
                                        <p class="cart__author"><%= p.author %></p>
                                    <% } %>
                                    <p class="cart__unit">$<%= Number(p.price).toFixed(2) %> each</p>
                                </div>

                                <div class="cart__stepper">
                                    <form action="/cart-update-item" method="POST">
                                        <input type="hidden" value="<%= p._id %>" name="productId">
                                        <input type="hidden" value="-1" name="delta">
                                        <button class="cart__step-btn" type="submit" aria-label="Decrease quantity" <%= p.quantity <= 1 ? 'disabled' : '' %>>&minus;</button>
                                    </form>
                                    <span class="numeric cart__quantity"><%= p.quantity %></span>
                                    <form action="/cart-update-item" method="POST">
                                        <input type="hidden" value="<%= p._id %>" name="productId">
                                        <input type="hidden" value="1" name="delta">
                                        <button class="cart__step-btn" type="submit" aria-label="Increase quantity">+</button>
                                    </form>
                                </div>

                                <div class="cart__line">
                                    <span class="numeric cart__line-total">$<%= (Number(p.price) * p.quantity).toFixed(2) %></span>
                                    <form action="/cart-delete-item" method="POST">
                                        <input type="hidden" value="<%= p._id %>" name="productId">
                                        <button class="btn btn--danger" type="submit">Remove</button>
                                    </form>
                                </div>
                            </li>
                        <% }) %>
                    </ul>

                    <section class="cart__summary">
                        <div class="cart__total-row">
                            <span class="eyebrow">Total</span>
                            <span class="numeric cart__total">$<%= totalPrice.toFixed(2) %></span>
                        </div>
                        <form action="/checkout" method="GET">
                            <button type="submit" class="btn btn--primary cart__order-btn">Checkout</button>
                        </form>
                    </section>
                <% } else { %>
                    <div class="empty-state">
                        <h1>Your cart is empty</h1>
                        <p class="empty-state__text">Nothing has been added yet.</p>
                        <a href="/products" class="btn btn--primary">Browse books</a>
                    </div>
                <% } %>
            </div>
        </main>
        <%- include('../includes/end.ejs') %>
