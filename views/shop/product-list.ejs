<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/catalog.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <div class="page">
                <% if (prods.length > 0) { %>
                    <header class="catalog__header">
                        <h1>All books</h1>
                        <span class="eyebrow"><%= prods.length %> title<%= prods.length === 1 ? '' : 's' %></span>
                    </header>
                    <div class="catalog__grid">
                        <% prods.forEach(product => { %>
                            <%- include('../includes/product-card.ejs', { product: product, cartProductIds: cartProductIds, returnTo: '/products' }) %>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <h1>The shelves are empty</h1>
                        <p class="empty-state__text">No titles have been added yet.</p>
                        <a class="btn btn--primary" href="/admin/add-product">Add the first book</a>
                    </div>
                <% } %>
            </div>
        </main>
        <%- include('../includes/end.ejs') %>
