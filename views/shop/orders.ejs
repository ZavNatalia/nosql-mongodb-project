<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/orders.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <main>
            <% if (orders.length <= 0) { %>
                <div class="orders orders--empty">
                    <h1 class="orders__title">No orders yet</h1>
                    <p class="orders__empty-text">Once you place an order, it will show up here.</p>
                    <a class="btn btn--primary" href="/products">Browse products</a>
                </div>
            <% } else { %>
                <div class="orders">
                    <header class="orders__header">
                        <h1 class="orders__title">Your Orders</h1>
                        <span class="orders__count"><%= orders.length %> order<%= orders.length === 1 ? '' : 's' %></span>
                    </header>
                    <ul class="orders__list">
                        <% orders.forEach(order => { %>
                            <%
                                const orderTotal = order.items.reduce((sum, item) => sum + Number(item.product.price) * item.quantity, 0);
                                const orderItems = order.items.reduce((sum, item) => sum + item.quantity, 0);
                                const createdAt = typeof order._id.getTimestamp === 'function' ? order._id.getTimestamp() : null;
                            %>
                            <li class="order">
                                <header class="order__header">
                                    <div class="order__meta">
                                        <h2 class="order__number">Order #<%= order._id.toString().slice(-6) %></h2>
                                        <% if (createdAt) { %>
                                            <time class="order__date" datetime="<%= createdAt.toISOString() %>">
                                                <%= createdAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                            </time>
                                        <% } %>
                                    </div>
                                    <div class="order__summary">
                                        <span class="order__items-count"><%= orderItems %> item<%= orderItems === 1 ? '' : 's' %></span>
                                        <span class="order__total">$<%= orderTotal.toFixed(2) %></span>
                                    </div>
                                </header>
                                <ul class="order__products">
                                    <% order.items.forEach(item => { %>
                                        <li class="order__product">
                                            <div class="order__product-image">
                                                <img src="<%= item.product.imageUrl %>" alt="<%= item.product.title %>">
                                            </div>
                                            <div class="order__product-info">
                                                <span class="order__product-title"><%= item.product.title %></span>
                                                <span class="order__product-price">
                                                    $<%= Number(item.product.price).toFixed(2) %>
                                                    <span class="order__product-quantity">&times; <%= item.quantity %></span>
                                                </span>
                                            </div>
                                            <span class="order__product-total">$<%= (Number(item.product.price) * item.quantity).toFixed(2) %></span>
                                        </li>
                                    <% }); %>
                                </ul>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>
        </main>
        <%- include('../includes/end.ejs') %>
