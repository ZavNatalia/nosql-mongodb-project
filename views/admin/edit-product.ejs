<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
</head>

<body>
   <%- include('../includes/navigation.ejs') %>

    <main>
        <form class="form-card product-form" action="/admin/<% if (editing) { %>edit-product<% } else { %>add-product<% } %>" method="POST">
            <h1 class="product-form__title"><% if (editing) { %>Edit Product<% } else { %>Add Product<% } %></h1>

            <div class="form-control">
                <label for="title">Title</label>
                <input type="text" name="title" id="title" placeholder="Product name" required value="<% if (editing) { %><%= product.title %><% } %>">
            </div>
            <div class="form-control">
                <label for="imageUrl">Image URL</label>
                <input type="url" name="imageUrl" id="imageUrl" placeholder="https://example.com/cover.png" required value="<% if (editing) { %><%= product.imageUrl %><% } %>">
            </div>
            <div class="form-control">
                <label for="price">Price</label>
                <input type="number" name="price" id="price" step="0.01" min="0" placeholder="0.00" required value="<% if (editing) { %><%= product.price %><% } %>">
            </div>
            <div class="form-control">
                <label for="description">Description</label>
                <textarea name="description" id="description" rows="5" placeholder="Short description of the product" required><% if (editing) { %><%= product.description %><% } %></textarea>
            </div>
            <% if (editing) { %>
                <input type="hidden" value="<%= product._id %>" name="productId">
            <% } %>

            <div class="product-form__actions">
                <button class="btn btn--primary" type="submit"><% if (editing) { %>Update Product<% } else { %>Add Product<% } %></button>
                <a class="btn" href="/admin/products">Cancel</a>
            </div>
        </form>
    </main>
<%- include('../includes/end.ejs') %>
