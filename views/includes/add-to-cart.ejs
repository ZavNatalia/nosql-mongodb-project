<% const extra = locals.extraClass || ''; %>
<% if (!isAvailable(product)) { %>
    <span class="book-status">Out of stock</span>
<% } else if (inCart) { %>
    <a class="btn btn--accent <%= extra %>" href="/cart">In cart &rarr;</a>
<% } else { %>
    <form action="/cart" method="post">
        <input type="hidden" name="productId" value="<%= product._id %>">
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <button class="btn btn--muted <%= extra %>" type="submit">Add to cart</button>
    </form>
<% } %>
