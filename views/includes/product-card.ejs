<article class="book-card">
    <a class="book-card__link" href="/products/<%= product._id %>">
        <div class="book-card__shelf" data-cover data-title="<%= product.title %>">
            <img src="<%= product.imageUrl %>" alt="Cover of <%= product.title %>" loading="lazy" decoding="async">
        </div>
        <div class="book-card__text">
            <% if (product.genre) { %>
                <span class="eyebrow book-card__genre"><%= product.genre %></span>
            <% } %>
            <h2 class="book-card__title"><%= product.title %></h2>
            <% if (product.author) { %>
                <p class="book-card__author"><%= product.author %></p>
            <% } %>
            <p class="book-card__description"><%= product.description %></p>
            <div class="book-card__foot">
                <span class="numeric book-card__price">$<%= Number(product.price).toFixed(2) %></span>
                <%- include('./book-meta.ejs', { product: product }) %>
            </div>
        </div>
    </a>
    <div class="book-card__action">
        <%- include('./add-to-cart.ejs', { product: product, inCart: cartProductIds.includes(product._id.toString()), returnTo: returnTo, extraClass: '' }) %>
    </div>
</article>
